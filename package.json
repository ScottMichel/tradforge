{
  "name": "tradforge",
  "version": "0.1.0",
  "description": "Pipeline de traduction locale par LLM, avec validation stricte et reprise incrémentale",
  "type": "module",
  "license": "MIT",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "tsx src/index.ts",
