{
  "name": "tradforge",
  "version": "0.1.0",
  "description": "Translate the texts of a project with a local LLM, with strict validation, a translation memory and incremental resume",
  "keywords": [
    "i18n",
    "localization",
    "translation",
    "llm",
    "ollama",
    "cli",
    "typescript",
    "game-modding"
  ],
  "author": "Kazuugnii",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ScottMichel/tradforge.git"
  },
  "homepage": "https://github.com/ScottMichel/tradforge#readme",
  "bugs": {
    "url": "https://github.com/ScottMichel/tradforge/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "tradforge": "./dist/cli/bin.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx src/cli/bin.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "check": "npm run typecheck && npm run lint && npm test",
    "prepublishOnly": "npm run check && npm run build"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
