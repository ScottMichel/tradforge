{
  "name": "tradforge-workspace",
  "private": true,
  "description": "The tradforge command line and library (packages/cli), and later its desktop application",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w tradforge --",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "npm test --workspaces --if-present",
    "test:watch": "npm run test:watch -w tradforge",
    "coverage": "npm run coverage -w tradforge",
    "check": "npm run typecheck && npm run lint && npm test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15"
  }
}
