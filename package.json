{
  "name": "tradforge",
  "version": "0.1.0",
  "description": "Translate the texts of a project with a local LLM, with strict validation, a translation memory and incremental resume",
  "type": "module",
  "license": "MIT",
  "engines": { "node": ">=22" },
  "bin": { "tradforge": "./dist/cli/bin.js" },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "dev": "tsx src/cli/bin.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
