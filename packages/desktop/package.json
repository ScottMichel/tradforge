{
  "name": "tradforge-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "The tradforge desktop application",
  "author": "Kazuugnii",
  "license": "MIT",
  "type": "module",
  "main": "dist/main/main.js",
  "scripts": {
    "dev": "tsc -p tsconfig.build.json && node scripts/dev.mjs",
    "build": "tsc -p tsconfig.build.json && vite build",
    "start": "electron .",
    "typecheck": "tsc --noEmit && tsc -p src/renderer/tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "tradforge": "0.1.0"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@types/node": "^26.6.5",
    "electron": "44.7.0",
    "typescript": "^7.0.2",
    "vite": "8.2.4",
    "vitest": "^5.0.5"
  }
}
